{
  "name": "polyman-cli",
  "version": "3.1.0",
  "description": "Polyman is a CLI tool that will allow codeforces problem setters to never get out of their coding environment to create a new problem. You can create, test, or update your problems and then submit them to polygon directly from your terminal.",
  "author": "Hamza Hassanain",
  "license": "MIT",
  "homepage": "https://hamzahassanain.github.io/polyman/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HamzaHassanain/polyman.git"
  },
  "bugs": {
    "url": "https://github.com/HamzaHassanain/polyman/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "cli.js",
  "bin": {
    "polyman": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "!dist/**/*.test.*",
    "!dist/demo-logger.*",
    "!dist/actions-old.*",
    "!dist/actions-refactored.*",
    "assets/checkers/*.cpp",
    "template/**/*",
    "!template/**/*.pdf",
    "README.md",
    "LICENCE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "watch": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\"",
    "docs": "typedoc",
    "docs:serve": "npm run docs && npx http-server docs -p 8080 -o",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chalk": "^0.4.31",
    "@types/commander": "^2.12.0",
    "@types/node": "^24.10.0",
    "@types/ora": "^3.1.0",
    "@typescript-eslint/eslint-plugin": "~8.48.0",
    "@typescript-eslint/parser": "~8.48.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "~8.48.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "execa": "^5.1.1"
  },
  "overrides": {
    "typedoc": {
      "minimatch": "^9.0.9"
    }
  }
}
