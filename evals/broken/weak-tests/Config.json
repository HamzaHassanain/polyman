        { "input": "./manual/tests/m-01-sample.in", "index": 1, "group": "samples", "useInStatements": true },
        { "input": "./manual/tests/m-02.in", "index": 2, "group": "main" },
        { "input": "./manual/tests/m-03.in", "index": 3, "group": "main" },
        { "input": "./manual/tests/m-04.in", "index": 4, "group": "main" },
        { "input": "./manual/tests/m-05.in", "index": 5, "group": "main" }
                      ],
      "groupsEnabled": true,
      "groups": [{ "name": "samples" }, { "name": "main" }]
    }
  ]
